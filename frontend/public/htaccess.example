# Apache rules for the built site.
#
# Deliberately NOT named .htaccess. Deploying is a manual upload of dist/, and
# anything in public/ is copied into dist/ verbatim — so a live .htaccess here
# would land in dist/ and overwrite whatever is on the server, breaking routing.
# The server's own .htaccess is the one that matters; this is a reference copy.
#
# To use it: open the .htaccess already on the server and make sure it contains
# the block below. Do not simply upload this file over it.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: send www to the bare domain, in the same hop as HTTPS.
  #
  # The two are separate origins as far as the browser is concerned, and
  # localStorage is per-origin — so the saved window colour, name, sound and
  # CRT settings and the play timer all silently reset on crossing between
  # them. That is the reason for this rule. The SEO argument is much weaker:
  # search engines pick one of a duplicate pair themselves and do not penalise
  # the other, so it is untidy rather than harmful.
  #
  # %1 is the host with the "www." taken off, so this leaves subdomains alone
  # instead of hardcoding the domain. It belongs before any HTTP-to-HTTPS rule,
  # or an http://www. URL takes two redirects instead of one.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # The CV used to carry a year in its filename. Anything already sent out
  # pointing at the old name still resolves. Deliberately unconditional: the
  # old file may well still be sitting on the server, and serving the outdated
  # CV to someone who kept the link is the thing being prevented.
  RewriteRule ^Jamie_Pates_Resume_2025\.pdf$ /Jamie_Pates_Resume.pdf [L,R=301]

  # Single-page app: unknown paths are routes, so hand them to index.html and
  # let React Router work out what they mean.
  #
  # The two conditions are the important part. Without them every request is
  # rewritten, including /contact.php, which would be served the contents of
  # index.html instead of being executed — the form would post to the app and
  # get HTML back. Excluding paths that exist on disk keeps the handler, the
  # assets and the PDF reachable.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# The contact form's config holds the recipient address and signing secret.
# contact.php reads it from disk; nothing should be able to fetch it over HTTP.
# The file guards itself with a CONTACT_APP check as well, so this is a second
# lock rather than the only one.
<Files "contact-config.php">
  Require all denied
</Files>

# The committed template is inert, but there is no reason to serve it either.
<Files "contact-config.example.php">
  Require all denied
</Files>

# Shared machinery for contact.php and guestbook.php. It refuses to run unless
# the requiring script has defined FORM_APP, so fetching it already yields a
# blank 403 — this is the same second lock the config file gets.
<Files "form-lib.php">
  Require all denied
</Files>
